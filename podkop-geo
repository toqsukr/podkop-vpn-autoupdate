#!/bin/sh
SECRETS="${PODKOP_GEO_SECRETS:-/etc/podkop-geo/secrets}"
SERVICE="${PODKOP_GEO_SERVICE:-/etc/init.d/podkop}"
RESOLVER="${PODKOP_GEO_RESOLVER:-$(uci -q get podkop.settings.bootstrap_dns_server || echo 77.88.8.8)}"
PORT="${PODKOP_GEO_PORT:-$(uci -q get podkop.main.mixed_proxy_port || echo 2080)}"
PROBE="${PODKOP_GEO_PROBE:-https://www.gstatic.com/generate_204}"
LOCK="${PODKOP_GEO_LOCK:-/var/lock/podkop-geo.pid}"
STATE="${PODKOP_GEO_STATE:-/tmp/podkop-geo}"
NAME="$(uci -q get podkop_geo.location.name)"
COUNTRY="$(uci -q get podkop_geo.location.country)"
REGION="$(uci -q get podkop_geo.location.region)"
CITY="$(uci -q get podkop_geo.location.city)"
TARGET="$(echo "$CITY, $REGION, $COUNTRY" | sed -e 's/^[, ]*//' -e 's/[, ]*$//' -e 's/, , /, /')"
OPTION=podkop.main.urltest_proxy_links

say() {
	logger -t podkop-geo "$*"
	echo "$*" >&2
}

fail() {
	say "$*"
	exit 1
}

subscriptions() {
	[ -r "$SECRETS" ] || fail "Secrets file $SECRETS is not readable"
	sed -e 's/\r$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$SECRETS" | grep -v -e '^$' -e '^#'
}

decoded() {
	if [ "$(head -c 2 "$1" | od -A n -t x1 | tr -d ' ')" = 1f8b ]; then
		gzip -dc "$1"
	elif grep -q '://' "$1"; then
		cat "$1"
	else
		tr -d ' \r\n\t' <"$1" | tr '_-' '/+' | awk '{ while (length($0) % 4) $0 = $0 "="; print }' | base64 -d 2>/dev/null
	fi
}

links() {
	body=$(mktemp)
	number=0
	subscriptions | while read -r url; do
		number=$((number + 1))
		curl -s -f -L --compressed -m 20 -o "$body" "$url" || { say "Subscription #$number failed to download with curl exit $?"; continue; }
		decoded "$body" | tr -d '\r' | grep '^vless://'
	done
	rm -f "$body"
}

named() {
	if [ -n "$NAME" ]; then
		LC_ALL=C awk '{ name = index($0, "#") ? substr($0, index($0, "#") + 1) : ""; out = ""; while (match(name, /%[0-9A-Fa-f][0-9A-Fa-f]/)) { out = out substr(name, 1, RSTART - 1) sprintf("%c", index("0123456789abcdef", tolower(substr(name, RSTART + 1, 1))) * 16 + index("0123456789abcdef", tolower(substr(name, RSTART + 2, 1))) - 17); name = substr(name, RSTART + 3) } print out name "\t" $0 }' | grep -i -E "^[^	]*($NAME)" | cut -f 2-
	else
		cat
	fi
}

host() {
	echo "$1" | sed -e 's|^vless://[^@]*@||' -e 's|[/?#].*||' -e 's|:[0-9]*$||' -e 's|^\[||' -e 's|\]$||'
}

address() {
	if echo "$1" | grep -q -E '^[0-9.]+$|:'; then
		echo "$1"
	else
		nslookup "$1" "$RESOLVER" 2>/dev/null | awk '/^Name:/ { found = 1 } found && /^Address/ { for (i = 2; i <= NF; i++) if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) { print $i; exit } }'
	fi
}

location() {
	cache="$STATE/geo/$1"
	if [ -n "$(find "$cache" -mmin -1440 2>/dev/null)" ]; then
		cat "$cache"
	else
		place=$(curl -s -m 10 "http://ip-api.com/line/$1?fields=status,countryCode,regionName,city" | tr -d '\r' | tr '\n' '|')
		case "$place" in success\|*) mkdir -p "$STATE/geo" && echo "$place" >"$cache" ;; esac
		echo "$place"
	fi
}

candidates() {
	links | awk '!seen[$0]++' | named | while read -r link; do
		ip=$(address "$(host "$link")")
		[ -n "$ip" ] || { say "Host $(host "$link") did not resolve"; continue; }
		place=$(location "$ip")
		say "Candidate $(host "$link") at $ip is located in $place"
		printf '%s\t%s\n' "$place" "$link"
	done
}

matching() {
	awk -F '\t' -v country="$COUNTRY" -v region="$REGION" -v city="$CITY" '{ split(tolower($1), p, "|") } p[1] == "success" && (country == "" || p[2] == tolower(country)) && (region == "" || p[3] == tolower(region)) && (city == "" || p[4] == tolower(city)) { print $2 }'
}

servers() {
	[ -n "$COUNTRY$REGION$CITY" ] || fail "Location is not set, fill podkop_geo.conf and run deploy.sh"
	chosen=$(candidates | matching)
	[ -n "$chosen" ] || fail "No server in $TARGET was found across subscriptions"
	echo "$chosen"
}

apply() {
	[ "$(uci -q get "$OPTION" | tr ' ' '\n' | sort)" = "$(echo "$1" | sort)" ] && { say "Podkop already uses the current servers in $TARGET"; return 0; }
	uci -q delete "$OPTION"
	echo "$1" | while read -r link; do uci add_list "$OPTION=$link"; done
	uci set podkop.main.proxy_config_type=urltest
	uci commit podkop
	"$SERVICE" restart
	say "Podkop switched to $(echo "$1" | wc -l | tr -d ' ') servers in $TARGET"
}

hold() {
	[ -f "$LOCK" ] && kill -0 "$(cat "$LOCK")" 2>/dev/null && fail "Another update is running as pid $(cat "$LOCK")"
	echo $$ >"$LOCK"
	trap 'rm -f "$LOCK"' EXIT
}

update() {
	hold
	mkdir -p "$STATE" && touch "$STATE/updated"
	list=$(servers) || exit 1
	apply "$list"
}

alive() {
	for attempt in 1 2 3; do
		[ "$(curl -s -o /dev/null -w '%{http_code}' -m 10 -x "socks5h://127.0.0.1:$PORT" "$PROBE")" = 204 ] && return 0
		say "Probe attempt $attempt through port $PORT failed"
	done
	return 1
}

check() {
	[ "$(uci -q get podkop.main.mixed_proxy_enabled)" = 1 ] || fail "Mixed proxy is disabled in podkop, health check cannot run"
	alive && return 0
	[ -n "$(find "$STATE/updated" -mmin -30 2>/dev/null)" ] && { say "Skipping update, the previous one ran less than 30 minutes ago"; return 0; }
	update
}

case "$1" in
	update) update ;;
	check) check ;;
	*) echo "Usage: podkop-geo check|update" >&2; exit 2 ;;
esac
