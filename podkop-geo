#!/bin/sh
SECRETS="${PODKOP_GEO_SECRETS:-/etc/podkop-geo/secrets}"
SERVICE="${PODKOP_GEO_SERVICE:-/etc/init.d/podkop}"
RESOLVER="${PODKOP_GEO_RESOLVER:-$(uci -q get podkop.settings.bootstrap_dns_server || echo 77.88.8.8)}"
PORT="${PODKOP_GEO_PORT:-$(uci -q get podkop.main.mixed_proxy_port || echo 2080)}"
PROBE="${PODKOP_GEO_PROBE:-https://www.gstatic.com/generate_204}"
NAME="$(uci -q get podkop_geo.location.name)"
COUNTRY="$(uci -q get podkop_geo.location.country)"
REGION="$(uci -q get podkop_geo.location.region)"
CITY="$(uci -q get podkop_geo.location.city)"
TARGET="$(echo "$CITY, $REGION, $COUNTRY" | sed -e 's/^[, ]*//' -e 's/[, ]*$//' -e 's/, , /, /')"
OPTION=podkop.main.urltest_proxy_links

say() {
	logger -t podkop-geo "$*"
	echo "$*" >&2
}

fail() {
	say "$*"
	exit 1
}

subscriptions() {
	[ -r "$SECRETS" ] || fail "Secrets file $SECRETS is not readable"
	sed -e 's/\r$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$SECRETS" | grep -v -e '^$' -e '^#'
}

decoded() {
	if [ "$(head -c 2 "$1" | od -A n -t x1 | tr -d ' ')" = 1f8b ]; then
		gzip -dc "$1"
	elif grep -q '://' "$1"; then
		cat "$1"
	else
		tr -d ' \r\n\t' <"$1" | tr '_-' '/+' | awk '{ while (length($0) % 4) $0 = $0 "="; print }' | base64 -d 2>/dev/null
	fi
}

links() {
	body=$(mktemp)
	subscriptions | while read -r url; do
		curl -s -f -L --compressed -m 20 -o "$body" "$url" || { say "Subscription ${url%%\?*} failed to download"; continue; }
		decoded "$body" | tr -d '\r' | grep '^vless://'
	done
	rm -f "$body"
}

named() {
	if [ -n "$NAME" ]; then grep -i -E "#.*($NAME)"; else cat; fi
}

host() {
	echo "$1" | sed -e 's|^vless://[^@]*@||' -e 's|[/?#].*||' -e 's|:[0-9]*$||' -e 's|^\[||' -e 's|\]$||'
}

address() {
	if echo "$1" | grep -q -E '^[0-9.]+$|:'; then
		echo "$1"
	else
		nslookup "$1" "$RESOLVER" 2>/dev/null | awk '/^Name:/ { found = 1 } found && /^Address/ { for (i = 2; i <= NF; i++) if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) { print $i; exit } }'
	fi
}

location() {
	curl -s -m 10 "http://ip-api.com/line/$1?fields=status,countryCode,regionName,city" | tr -d '\r' | tr '\n' '|'
}

candidates() {
	links | awk '!seen[$0]++' | named | while read -r link; do
		ip=$(address "$(host "$link")")
		[ -n "$ip" ] || { say "Host $(host "$link") did not resolve"; continue; }
		place=$(location "$ip")
		say "Candidate $(host "$link") at $ip is located in $place"
		printf '%s\t%s\n' "$place" "$link"
	done
}

matching() {
	awk -F '\t' -v country="$COUNTRY" -v field="$1" -v value="$2" '{ split(tolower($1), p, "|") } p[1] == "success" && (country == "" || p[2] == tolower(country)) && (value == "" || p[field] == tolower(value)) { print $2 }'
}

servers() {
	[ -n "$COUNTRY$REGION$CITY" ] || fail "Location is not set, configure podkop_geo.location with uci"
	pool=$(candidates)
	chosen=
	[ -n "$CITY" ] && chosen=$(printf '%s\n' "$pool" | matching 4 "$CITY")
	[ -n "$chosen" ] || [ -z "$REGION" ] || chosen=$(printf '%s\n' "$pool" | matching 3 "$REGION")
	[ -n "$chosen" ] || [ -n "$CITY$REGION" ] || chosen=$(printf '%s\n' "$pool" | matching 2 "")
	[ -n "$chosen" ] || fail "No server in $TARGET was found across subscriptions"
	echo "$chosen"
}

apply() {
	[ "$(uci -q get "$OPTION")" = "$(echo "$1" | tr '\n' ' ' | sed 's/ $//')" ] && { say "Podkop already uses the current servers in $TARGET"; return 0; }
	uci -q delete "$OPTION"
	echo "$1" | while read -r link; do uci add_list "$OPTION=$link"; done
	uci set podkop.main.proxy_config_type=urltest
	uci commit podkop
	"$SERVICE" restart
	say "Podkop switched to $(echo "$1" | wc -l | tr -d ' ') servers in $TARGET"
}

update() {
	lock /var/lock/podkop-geo
	list=$(servers) || { lock -u /var/lock/podkop-geo; exit 1; }
	apply "$list"
	lock -u /var/lock/podkop-geo
}

alive() {
	for attempt in 1 2 3; do
		[ "$(curl -s -o /dev/null -w '%{http_code}' -m 10 -x "socks5h://127.0.0.1:$PORT" "$PROBE")" = 204 ] && return 0
		say "Probe attempt $attempt through port $PORT failed"
	done
	return 1
}

check() {
	alive || update
}

case "$1" in
	update) update ;;
	check) check ;;
	*) echo "Usage: podkop-geo check|update" >&2; exit 2 ;;
esac
